<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelManagement</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #1f2937; background: #f3f4f6; }
        body { margin: 0; }
        header { padding: 1rem 2rem; background: #123047; color: white; }
        header a { color: white; text-decoration: none; font-weight: 700; }
        main { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
        h1 { margin-top: 0; }
        .card { padding: 1.5rem; background: white; border: 1px solid #d1d5db; border-radius: .5rem; }
        .actions { display: flex; gap: .75rem; align-items: center; }
        .button { display: inline-block; padding: .55rem .85rem; border: 0; border-radius: .3rem; background: #176b87; color: white; text-decoration: none; cursor: pointer; font: inherit; }
        .button.secondary { background: #4b5563; }
        .button.danger { background: #b42318; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th, td { padding: .75rem; border-bottom: 1px solid #d1d5db; text-align: left; }
        label { display: block; margin: 1rem 0 .35rem; font-weight: 600; }
        input { box-sizing: border-box; width: 100%; padding: .6rem; border: 1px solid #9ca3af; border-radius: .3rem; font: inherit; }
        .validation, .field-validation-error { color: #b42318; }
        .muted { color: #6b7280; }
    </style>
</head>
<body>
    <header><a asp-area="" asp-controller="Home" asp-action="Index">HotelManagement</a></header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
