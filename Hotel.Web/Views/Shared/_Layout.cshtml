<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelManagement</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #1f2937; background: #f3f4f6; }
        body { margin: 0; }
        header { padding: 1rem 2rem; background: #123047; color: white; }
        header a { color: white; text-decoration: none; font-weight: 700; }
        main { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
        h1 { margin-top: 0; }
        .card { padding: 1.5rem; background: white; border: 1px solid #d1d5db; border-radius: .5rem; }
        .actions { display: flex; gap: .75rem; align-items: center; }
        .button { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; padding: .55rem .8rem; border: 0; border-radius: .2rem; background: #176b87; color: white; text-decoration: none; cursor: pointer; font: inherit; font-size: .9rem; font-weight: 600; transition: background-color .15s, box-shadow .15s; }
        .button:hover { background: #12566d; color: white; }
        .button:focus-visible, .icon-button:focus-visible { outline: 3px solid rgb(23 107 135 / 25%); outline-offset: 2px; }
        .button svg, .icon-button svg { width: 1rem; height: 1rem; flex: 0 0 auto; }
        .button.secondary { background: #4b5563; }
        .button.secondary:hover { background: #374151; }
        .button.danger { background: #b42318; }
        .button.danger:hover { background: #912018; }
        .button-icon { width: 1rem; height: 1rem; }
        .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        .organization-details { max-width: 820px; margin: 0 auto; }
        .detail-breadcrumb { display: flex; align-items: center; gap: .55rem; margin-bottom: 1rem; color: #9ca3af; font-size: .85rem; }
        .detail-breadcrumb a { color: #176b87; text-decoration: none; }
        .detail-breadcrumb a:hover { text-decoration: underline; }
        .organization-profile { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.5rem; box-shadow: 0 8px 24px rgb(15 23 42 / 5%); }
        .organization-identity { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
        .organization-avatar { flex: 0 0 76px; width: 76px; height: 76px; object-fit: contain; padding: .45rem; border: 1px solid #e5e7eb; border-radius: .8rem; background: white; }
        .organization-avatar-fallback { display: grid; place-items: center; border: 0; background: #e5eef2; color: #176b87; font-size: 1.8rem; font-weight: 700; }
        .organization-heading { min-width: 0; }
        .organization-heading .eyebrow { margin: 0 0 .35rem; }
        .organization-heading h1 { margin: 0; overflow-wrap: anywhere; font-size: 1.65rem; letter-spacing: -.035em; }
        .organization-code { margin: .45rem 0 0; color: #6b7280; font-size: .85rem; }
        .organization-code strong { margin-left: .25rem; color: #374151; font-weight: 600; }
        .organization-profile-actions { display: flex; align-items: center; gap: .8rem; }
        .status-badge { display: inline-flex; align-items: center; gap: .4rem; padding: .4rem .65rem; border-radius: 999px; font-size: .8rem; font-weight: 650; white-space: nowrap; }
        .status-active { background: #ecfdf3; color: #027a48; }
        .status-inactive { background: #f3f4f6; color: #4b5563; }
        .status-indicator { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; }
        .detail-section { margin-top: 1.75rem; }
        .detail-section-heading { margin-bottom: .85rem; }
        .detail-section-heading h2 { margin: 0; font-size: 1.1rem; letter-spacing: -.015em; }
        .detail-section-heading p { margin: .3rem 0 0; font-size: .88rem; }
        .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .detail-item { display: flex; align-items: flex-start; gap: .85rem; min-width: 0; padding: 1.1rem; }
        .detail-icon { display: grid; flex: 0 0 2.25rem; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: .55rem; background: #eef5f7; color: #176b87; }
        .detail-item h3 { margin: .1rem 0 .35rem; color: #6b7280; font-size: .78rem; font-weight: 600; }
        .detail-item a { color: #176b87; overflow-wrap: anywhere; font-size: .92rem; text-decoration: none; }
        .detail-item a:hover { text-decoration: underline; }
        .detail-empty { margin: 0; color: #9ca3af; font-size: .9rem; }
        .detail-footer { display: flex; justify-content: flex-start; margin-top: 1.25rem; }
        .organization-list-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.25rem; }
        .organization-list-heading h1 { margin: 0; font-size: 1.8rem; letter-spacing: -.03em; }
        .organization-list-heading p { margin: .35rem 0 0; }
        .organization-table-card { padding: 0; overflow: hidden; box-shadow: 0 8px 24px rgb(15 23 42 / 5%); }
        .table-scroll { overflow-x: auto; }
        .organization-table { min-width: 720px; }
        .organization-table th { color: #6b7280; background: #f9fafb; font-size: .76rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
        .organization-table td { vertical-align: middle; font-size: .9rem; }
        .organization-name-cell { display: flex; align-items: center; gap: .7rem; min-width: 180px; }
        .table-avatar { display: grid; flex: 0 0 2.25rem; width: 2.25rem; height: 2.25rem; place-items: center; overflow: hidden; border-radius: .25rem; background: #e5eef2; color: #176b87; font-weight: 700; }
        .table-avatar img { width: 100%; height: 100%; object-fit: contain; background: white; }
        .organization-name { color: #1f2937; font-weight: 650; text-decoration: none; }
        .organization-name:hover { color: #176b87; }
        .organization-code-cell { display: block; margin-top: .15rem; color: #6b7280; font-size: .78rem; }
        .table-status { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .55rem; border-radius: .2rem; font-size: .76rem; font-weight: 650; }
        .table-status-active { background: #ecfdf3; color: #027a48; }
        .table-status-inactive { background: #f3f4f6; color: #4b5563; }
        .table-actions { display: flex; align-items: center; gap: .35rem; }
        .icon-button { display: inline-grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid #e5e7eb; border-radius: .2rem; background: white; color: #4b5563; text-decoration: none; cursor: pointer; transition: background-color .15s, color .15s, border-color .15s; }
        .icon-button:hover { border-color: #bfdae3; background: #eef5f7; color: #12566d; }
        .icon-button.danger:hover { border-color: #fecdca; background: #fef3f2; color: #b42318; }
        .empty-state { padding: 3rem 1.5rem; text-align: center; }
        .empty-state-icon { display: grid; width: 3rem; height: 3rem; place-items: center; margin: 0 auto .9rem; border-radius: .35rem; background: #eef5f7; color: #176b87; }
        .empty-state-icon svg { width: 1.5rem; height: 1.5rem; }
        .empty-state h2 { margin: 0; font-size: 1.1rem; }
        .empty-state p { margin: .4rem 0 1.1rem; color: #6b7280; }
        .confirmation-card { max-width: 620px; padding: 0; overflow: hidden; box-shadow: 0 12px 30px rgb(15 23 42 / 7%); }
        .confirmation-body { padding: 1.5rem; }
        .confirmation-icon { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; margin-bottom: 1rem; border-radius: .3rem; background: #fef3f2; color: #b42318; }
        .confirmation-icon svg { width: 1.4rem; height: 1.4rem; }
        .confirmation-body h1 { margin: 0; font-size: 1.45rem; }
        .confirmation-body p { color: #6b7280; }
        .organization-summary { margin-top: 1.25rem; padding: 1rem; border: 1px solid #e5e7eb; border-radius: .2rem; background: #f9fafb; }
        .organization-summary strong, .organization-summary span { display: block; }
        .organization-summary span { margin-top: .2rem; color: #6b7280; font-size: .85rem; }
        .confirmation-actions { display: flex; justify-content: flex-end; gap: .6rem; padding: 1rem 1.5rem; border-top: 1px solid #e5e7eb; background: #f9fafb; }
        .page-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.25rem; }
        .page-heading h1 { margin: 0; font-size: 1.8rem; letter-spacing: -.03em; }
        .page-heading p { margin: .4rem 0 0; }
        .eyebrow { color: #176b87; font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
        .organization-form { max-width: 760px; padding: 0; overflow: hidden; box-shadow: 0 12px 30px rgb(15 23 42 / 7%); }
        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem 1.25rem; padding: 1.5rem; }
        .form-field { min-width: 0; }
        .form-field-wide { grid-column: 1 / -1; }
        .form-field > label { display: block; margin: 0 0 .45rem; color: #374151; font-size: .88rem; font-weight: 650; }
        .form-control { width: 100%; padding: .72rem .8rem; border: 1px solid #d1d5db; border-radius: .45rem; background: #fff; color: #1f2937; transition: border-color .15s, box-shadow .15s; }
        .form-control::placeholder { color: #9ca3af; }
        .form-control:focus { outline: none; border-color: #176b87; box-shadow: 0 0 0 3px rgb(23 107 135 / 14%); }
        .form-field .field-validation-error { display: block; margin-top: .35rem; font-size: .8rem; }
        .file-control { padding: .5rem; }
        .file-control::file-selector-button { margin-right: .75rem; padding: .45rem .7rem; border: 0; border-radius: .3rem; background: #e5eef2; color: #123047; font: inherit; cursor: pointer; }
        .field-hint { display: block; margin-top: .4rem; color: #6b7280; font-size: .8rem; }
        .logo-preview { display: flex; align-items: center; gap: .75rem; margin-bottom: .75rem; color: #6b7280; font-size: .85rem; }
        .logo-preview img { width: 64px; height: 64px; object-fit: contain; padding: .35rem; border: 1px solid #e5e7eb; border-radius: .45rem; background: white; }
        .form-validation { padding: 1rem 1.5rem 0; }
        .active-toggle { display: flex !important; align-items: center; gap: .75rem; margin: 0 !important; padding: .9rem 1rem; border: 1px solid #e5e7eb; border-radius: .5rem; background: #f9fafb; cursor: pointer; }
        .active-checkbox { width: 1.05rem; height: 1.05rem; margin: 0; accent-color: #176b87; }
        .active-toggle strong, .active-toggle small { display: block; }
        .active-toggle strong { color: #374151; font-size: .9rem; }
        .active-toggle small { margin-top: .2rem; color: #6b7280; font-size: .8rem; font-weight: 400; }
        .form-actions { display: flex; justify-content: flex-end; gap: .75rem; padding: 1rem 1.5rem; border-top: 1px solid #e5e7eb; background: #f9fafb; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th, td { padding: .75rem; border-bottom: 1px solid #d1d5db; text-align: left; }
        label { display: block; margin: 1rem 0 .35rem; font-weight: 600; }
        input { box-sizing: border-box; width: 100%; padding: .6rem; border: 1px solid #9ca3af; border-radius: .3rem; font: inherit; }
        .validation, .field-validation-error { color: #b42318; }
        .muted { color: #6b7280; }
        @@media (max-width: 600px) {
            main { margin: 1.25rem auto; }
            .page-heading { align-items: flex-start; flex-direction: column; gap: .9rem; }
            .organization-list-heading { align-items: flex-start; flex-direction: column; }
            .organization-list-heading .button { width: 100%; }
            .organization-profile { align-items: flex-start; flex-direction: column; padding: 1.1rem; }
            .organization-profile-actions { width: 100%; justify-content: space-between; }
            .organization-avatar { flex-basis: 60px; width: 60px; height: 60px; }
            .organization-heading h1 { font-size: 1.35rem; }
            .detail-grid { grid-template-columns: 1fr; gap: .7rem; }
            .form-grid { grid-template-columns: 1fr; gap: 1rem; padding: 1.1rem; }
            .form-field-wide { grid-column: auto; }
            .form-validation { padding: 1rem 1.1rem 0; }
            .form-actions { padding: .9rem 1.1rem; }
            .form-actions .button { flex: 1; text-align: center; }
            .confirmation-actions { padding: .9rem 1.1rem; }
            .confirmation-actions .button { flex: 1; }
        }
    </style>
</head>
<body>
    <header><a asp-area="" asp-controller="Home" asp-action="Index">HotelManagement</a></header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
