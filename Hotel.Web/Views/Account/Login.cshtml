@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="auth-eyebrow">HOTEL MANAGEMENT</p>
        <h1>Chào mừng trở lại</h1>
        <p class="auth-description">Đăng nhập để tiếp tục sử dụng hệ thống khách sạn.</p>

        @if (TempData["AccountMessage"] is string message)
        {
            <div class="auth-success" role="status">@message</div>
        }

        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="auth-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password">Mật khẩu</label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <button class="button auth-submit" type="submit">Đăng nhập</button>
        </form>

        <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </div>
</section>
