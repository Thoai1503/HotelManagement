@model HotelModal
@{
    ViewData["Title"] = "Edit hotel";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">TENANT MANAGEMENT</p>
        <h1>Edit hotel</h1>
        <p class="muted">Update hotel details, organization, and contact information.</p>
    </div>
    <a class="button secondary" asp-area="Tenant" asp-controller="Hotel" asp-action="Details" asp-route-id="@Model.id">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m15 18-6-6 6-6M9 12h12" />
        </svg>
        Back to hotel
    </a>
</div>

<form asp-area="Tenant" asp-controller="Hotel" asp-action="Edit" asp-route-id="@Model.id" method="post" class="card organization-form">
    <partial name="_HotelForm" model="Model" />
    <div class="form-actions">
        <a class="button secondary" asp-area="Tenant" asp-controller="Hotel" asp-action="Details" asp-route-id="@Model.id">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="m15 18-6-6 6-6M9 12h12" />
            </svg>
            Cancel
        </a>
        <button class="button" type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 12.5 9.5 17 20 6.5" />
            </svg>
            Save changes
        </button>
    </div>
</form>
