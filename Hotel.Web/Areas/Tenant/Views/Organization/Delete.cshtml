@model OrganizationModal
@{
    ViewData["Title"] = "Delete organization";
}

<h1>Delete organization</h1>
<div class="card">
    <p>Are you sure you want to delete this organization?</p>
    <p><strong>@Model.name</strong> <span class="muted">(@Model.code)</span></p>
    <form asp-area="Tenant" asp-action="Delete" asp-route-id="@Model.id" method="post" class="actions">
        <button class="button danger" type="submit">Delete</button>
        <a class="button secondary" asp-area="Tenant" asp-action="Index">Cancel</a>
    </form>
</div>
