@model OrganizationModal
@{
    ViewData["Title"] = "Edit organization";
}

<h1>Edit organization</h1>
<form asp-area="Tenant" asp-action="Edit" asp-route-id="@Model.id" method="post" class="card">
    <partial name="_OrganizationForm" model="Model" />
    <div class="actions" style="margin-top:1.25rem">
        <button class="button" type="submit">Save changes</button>
        <a class="button secondary" asp-area="Tenant" asp-action="Index">Cancel</a>
    </div>
</form>
